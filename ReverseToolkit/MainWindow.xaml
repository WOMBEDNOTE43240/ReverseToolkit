<Window x:Class="ReverseToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReverseToolkit.Localization"
        Title="Reverse Engineering Toolkit" 
        Height="800" Width="1400"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <Binding Source="{x:Static local:LocalizationManager.Instance}"/>
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" 
              Foreground="{StaticResource ForegroundBrush}">
            <MenuItem Header="{Binding [Menu.File]}">
                <MenuItem Header="{Binding [Menu.OpenFile]}" Click="OpenFile_Click"/>
                <MenuItem Header="{Binding [Menu.OpenProcess]}" Click="OpenProcess_Click"/>
                <Separator/>
                <MenuItem Header="{Binding [Menu.Exit]}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{Binding [Menu.Tools]}">
                <MenuItem Header="{Binding [Menu.Settings]}" Click="Settings_Click"/>
                <MenuItem Header="{Binding [Menu.About]}" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="{Binding [Menu.Language]}" Click="ChangeLanguage_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Main TabControl -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" Margin="5">
            
            <!-- PE Analyzer Tab -->
            <TabItem Header="{Binding [Tab.PEAnalyzer]}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <TextBox x:Name="PEFilePathTextBox" Width="600" IsReadOnly="True"/>
                        <Button Content="{Binding [PE.LoadPE]}" Click="LoadPE_Click"/>
                        <Button Content="{Binding [Button.Export]}" Click="ExportPE_Click"/>
                    </StackPanel>
                    
                    <TabControl Grid.Row="1" Margin="5">
                        <TabItem Header="{Binding [PE.Headers]}">
                            <ScrollViewer>
                                <TextBlock x:Name="PEHeadersTextBlock" FontFamily="Consolas" 
                                         Foreground="{StaticResource ForegroundBrush}" Margin="10"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{Binding [PE.Sections]}">
                            <DataGrid x:Name="PESectionsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [PE.Name], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="{Binding [PE.VirtualAddress], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding VirtualAddress}" Width="150"/>
                                    <DataGridTextColumn Header="{Binding [PE.VirtualSize], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding VirtualSize}" Width="150"/>
                                    <DataGridTextColumn Header="{Binding [PE.RawSize], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding RawSize}" Width="150"/>
                                    <DataGridTextColumn Header="{Binding [PE.Characteristics], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Characteristics}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{Binding [PE.Imports]}">
                            <DataGrid x:Name="PEImportsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [PE.DLL], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding DllName}" Width="200"/>
                                    <DataGridTextColumn Header="{Binding [PE.Function], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding FunctionName}" Width="*"/>
                                    <DataGridTextColumn Header="{Binding [PE.Address], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Address}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{Binding [PE.Exports]}">
                            <DataGrid x:Name="PEExportsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [PE.Function], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding FunctionName}" Width="*"/>
                                    <DataGridTextColumn Header="{Binding [PE.Ordinal], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Ordinal}" Width="100"/>
                                    <DataGridTextColumn Header="{Binding [PE.RVA], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Rva}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            
            <!-- Hex Editor Tab -->
            <TabItem Header="{Binding [Tab.HexEditor]}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <TextBox x:Name="HexFilePathTextBox" Width="600" IsReadOnly="True"/>
                        <Button Content="{Binding [Button.Open]}" Click="LoadHex_Click"/>
                        <Button Content="{Binding [Button.Save]}" Click="SaveHex_Click"/>
                        <Button Content="{Binding [Button.Search]}" Click="SearchHex_Click"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="HexEditorTextBox" FontFamily="Consolas" FontSize="12"
                                AcceptsReturn="True" IsReadOnly="False" 
                                Background="{StaticResource SecondaryBackgroundBrush}"
                                Foreground="{StaticResource ForegroundBrush}"/>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding [Hex.Offset]}" Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBox x:Name="HexOffsetTextBox" Width="150" Text="0x00000000"/>
                        <Button Content="{Binding [Hex.GoTo]}" Click="GoToOffset_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- Memory Scanner Tab -->
            <TabItem Header="{Binding [Tab.MemoryScanner]}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Process List -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="5">
                            <TextBlock Text="{Binding [Memory.Processes]}" Foreground="{StaticResource ForegroundBrush}" Margin="5"/>
                            <Button Content="{Binding [Memory.RefreshList]}" Click="RefreshProcesses_Click"/>
                        </StackPanel>
                        
                        <ListBox Grid.Row="1" x:Name="ProcessListBox" Margin="5" 
                                SelectionChanged="ProcessListBox_SelectionChanged"/>
                    </Grid>
                    
                    <!-- Scanner Controls -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="5">
                            <TextBlock Text="{Binding [Memory.MemorySearch]}" Foreground="{StaticResource ForegroundBrush}" Margin="5"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ScanTypeComboBox" Width="150" Margin="5">
                                    <ComboBoxItem Content="Exact Value" IsSelected="True"/>
                                    <ComboBoxItem Content="Unknown Value"/>
                                    <ComboBoxItem Content="Range"/>
                                    <ComboBoxItem Content="Pattern"/>
                                </ComboBox>
                                <ComboBox x:Name="ValueTypeComboBox" Width="100" Margin="5">
                                    <ComboBoxItem Content="Int32" IsSelected="True"/>
                                    <ComboBoxItem Content="Int64"/>
                                    <ComboBoxItem Content="Float"/>
                                    <ComboBoxItem Content="Double"/>
                                    <ComboBoxItem Content="String"/>
                                    <ComboBoxItem Content="Bytes"/>
                                </ComboBox>
                                <TextBox x:Name="ScanValueTextBox" Width="200" />
                                <Button Content="{Binding [Memory.FirstScan]}" Click="FirstScan_Click"/>
                                <Button Content="{Binding [Memory.NextScan]}" Click="NextScan_Click"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" x:Name="MemoryResultsDataGrid" AutoGenerateColumns="False" 
                                 IsReadOnly="False" Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [PE.Address], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Address}" Width="150"/>
                                <DataGridTextColumn Header="{Binding [Memory.Value], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Value}" Width="150"/>
                                <DataGridTextColumn Header="{Binding [Memory.Previous], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding PreviousValue}" Width="150"/>
                                <DataGridTextColumn Header="{Binding [Memory.Type], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Type}" Width="100"/>
                                <DataGridTemplateColumn Header="{Binding [Memory.Actions], Source={x:Static local:LocalizationManager.Instance}}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding [Button.Modify], Source={x:Static local:LocalizationManager.Instance}}" Click="ModifyMemory_Click" Tag="{Binding}"/>
                                                <Button Content="{Binding [Button.Freeze], Source={x:Static local:LocalizationManager.Instance}}" Click="FreezeMemory_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- Pattern Scanner Tab -->
            <TabItem Header="🔍 Pattern Scanner">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="5">
                        <TextBlock Text="Pattern search:" Foreground="{StaticResource ForegroundBrush}" Margin="5"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="PatternTargetComboBox" Width="150" Margin="5">
                                <ComboBoxItem Content="In file" IsSelected="True"/>
                                <ComboBoxItem Content="In process memory"/>
                            </ComboBox>
                            <TextBox x:Name="PatternTextBox" Width="400" 
                                    Text="E8 ? ? ? ? 48 8B" 
                                    ToolTip="Format: E8 ? ? ? ? (? = any byte)"/>
                            <Button Content="Search" Click="SearchPattern_Click"/>
                            <Button Content="Clear" Click="ClearPattern_Click"/>
                        </StackPanel>
                        <TextBlock Text="Примеры: 'E8 ? ? ? ?', '48 8B 0D ? ? ? ?', 'FF 25'" 
                                  Foreground="{StaticResource WarningBrush}" Margin="5"/>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" x:Name="PatternResultsDataGrid" AutoGenerateColumns="False" 
                             IsReadOnly="True" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Адрес/Offset" Binding="{Binding Address}" Width="150"/>
                            <DataGridTextColumn Header="Паттерн" Binding="{Binding Pattern}" Width="300"/>
                            <DataGridTextColumn Header="Контекст (байты)" Binding="{Binding Context}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <!-- Disassembler Tab -->
            <TabItem Header="{Binding [Tab.Disassembler]}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <ComboBox x:Name="DisasmArchComboBox" Width="100" Margin="5">
                            <ComboBoxItem Content="x86" />
                            <ComboBoxItem Content="x64" IsSelected="True"/>
                        </ComboBox>
                        <TextBox x:Name="DisasmAddressTextBox" Width="150" Text="0x00000000"/>
                        <TextBox x:Name="DisasmSizeTextBox" Width="100" Text="100"/>
                        <Button Content="{Binding [Disasm.Disassemble]}" Click="Disassemble_Click"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DisassemblyTextBlock" FontFamily="Consolas" FontSize="12"
                                  Foreground="{StaticResource ForegroundBrush}" Margin="10"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <!-- Network Monitor Tab -->
            <TabItem Header="{Binding [Tab.NetworkMonitor]}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [Network.ProcessToMonitor]}" 
                                      Foreground="{StaticResource ForegroundBrush}" 
                                      VerticalAlignment="Center" Margin="5"/>
                            <ComboBox x:Name="NetworkProcessComboBox" Width="250" Margin="5"/>
                            <Button Content="{Binding [Network.RefreshProcesses]}" Click="RefreshNetworkProcesses_Click"/>
                            <Button Content="{Binding [Network.StartMonitoring]}" Click="StartNetworkMonitoring_Click"/>
                            <Button Content="{Binding [Button.Stop]}" Click="StopNetworkMonitoring_Click"/>
                            <Button Content="{Binding [Network.ClearLog]}" Click="ClearNetworkLog_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="FilterHTTPCheckBox" Content="HTTP/HTTPS" IsChecked="True" 
                                     Margin="5" Foreground="{StaticResource ForegroundBrush}"/>
                            <CheckBox x:Name="FilterDNSCheckBox" Content="DNS" IsChecked="True" 
                                     Margin="5" Foreground="{StaticResource ForegroundBrush}"/>
                            <CheckBox x:Name="FilterAllTrafficCheckBox" Content="{Binding [Network.AllTraffic]}" 
                                     Margin="5" Foreground="{StaticResource ForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Network Connections Table -->
                    <DataGrid Grid.Row="1" x:Name="NetworkConnectionsDataGrid" AutoGenerateColumns="False" 
                             IsReadOnly="True" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Network.Time], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Timestamp}" Width="150"/>
                            <DataGridTextColumn Header="{Binding [Network.Protocol], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Protocol}" Width="80"/>
                            <DataGridTextColumn Header="{Binding [Network.Source], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Source}" Width="200"/>
                            <DataGridTextColumn Header="{Binding [Network.Destination], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Destination}" Width="200"/>
                            <DataGridTextColumn Header="{Binding [Network.URLHost], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Url}" Width="*"/>
                            <DataGridTextColumn Header="{Binding [Network.Size], Source={x:Static local:LocalizationManager.Instance}}" Binding="{Binding Size}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Packet Details -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="{Binding [Network.PacketDetails]}" 
                                  Foreground="{StaticResource ForegroundBrush}" Margin="5"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PacketDetailsTextBlock" FontFamily="Consolas" FontSize="11"
                                      Foreground="{StaticResource ForegroundBrush}" Margin="10"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource SecondaryBackgroundBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" 
                          Foreground="{StaticResource ForegroundBrush}" 
                          Text="{Binding [Common.Ready]}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
