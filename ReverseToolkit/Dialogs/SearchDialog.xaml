<Window x:Class="ReverseToolkit.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search" Height="200" Width="400"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" x:Name="PromptTextBlock" 
                  Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" x:Name="SearchPatternTextBox" Height="30" Margin="0,0,0,15"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SearchButton" Width="80" Click="Search_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Width="80" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
